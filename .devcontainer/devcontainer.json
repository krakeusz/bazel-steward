{
  "name": "bazel-steward-ci-arm64",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "ci"
  },
  "runArgs": [
    "--platform=linux/arm64",
    "--network=machine-ci-bazel-steward-buildbarn_default"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/bazel-steward,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/bazel-steward",
  "containerUser": "runner",
  "mounts": [
    "source=bazel-steward-ci-cache,target=/home/runner/.cache,type=volume"
  ],
  "containerEnv": {
    "PRE_COMMIT_HOME": "/home/runner/.cache/pre-commit"
  }
}
