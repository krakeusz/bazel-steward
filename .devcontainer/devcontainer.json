{
  "name": "bazel-steward-ci-arm64",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "ci"
  },
  "runArgs": [
    "--platform=linux/arm64"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/bazel-steward,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/bazel-steward",
  "mounts": [
    "source=bazel-steward-ci-cache,target=/var/cache/ci,type=volume"
  ],
  "containerEnv": {
    "PRE_COMMIT_HOME": "/var/cache/ci/pre-commit"
  }
}
